# Generated by cratepkg 0.1.0. Run `makepkg -si` to build and install, or `makepkg -f` to only build.
pkgname=spawnpkg
pkgver=0.1.0
pkgrel=1
pkgdesc='Check a project name across ecosystems, scaffold a Rust tool, and publish it to GitHub'
arch=('x86_64' 'aarch64')
url='https://github.com/lazybrar/spawnpkg'
license=('GPL-2.0-or-later')
depends=('gcc-libs' 'glibc')
makedepends=('cargo')
options=('!debug')

prepare() {
  cd "$startdir/.."
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$startdir/.."
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --frozen --release
}

check() {
  cd "$startdir/.."
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --frozen --release
}

package() {
  install -Dm755 "$srcdir/target/release/spawnpkg" "$pkgdir/usr/bin/spawnpkg"
  install -Dm644 "$startdir/../README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$startdir/../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
